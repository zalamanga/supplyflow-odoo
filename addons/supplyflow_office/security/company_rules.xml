<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="request_company_rule" model="ir.rule">
        <field name="name">SupplyFlow request company isolation</field>
        <field name="model_id" ref="model_supplyflow_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="request_line_company_rule" model="ir.rule">
        <field name="name">SupplyFlow request line company isolation</field>
        <field name="model_id" ref="model_supplyflow_request_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="issue_company_rule" model="ir.rule">
        <field name="name">SupplyFlow supplier issue company isolation</field>
        <field name="model_id" ref="model_supplyflow_issue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="issue_line_company_rule" model="ir.rule">
        <field name="name">SupplyFlow issue line company isolation</field>
        <field name="model_id" ref="model_supplyflow_issue_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
