<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sequence_request" model="ir.sequence">
        <field name="name">SupplyFlow purchase request</field>
        <field name="code">supplyflow.request</field>
        <field name="prefix">REQ/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_issue" model="ir.sequence">
        <field name="name">SupplyFlow supplier issue</field>
        <field name="code">supplyflow.issue</field>
        <field name="prefix">ISS/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
